# AI providers for flux-agent, tried in FLUX_AI_PROVIDERS order with failover.
# Providers without credentials are skipped; with none configured, the local
# rule engine handles common requests on its own.

FLUX_AI_PROVIDERS=anthropic,openai,ollama
# auto: local rules for common requests, LLM for novel ones. local: rules only. llm: always LLM.
FLUX_AI_ROUTING=auto

# Anthropic (Claude)
ANTHROPIC_API_KEY=
FLUX_ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI, or any OpenAI-compatible endpoint (OpenRouter, Groq, vLLM, LM Studio)
OPENAI_API_KEY=
FLUX_OPENAI_MODEL=gpt-6.2-sol
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local models via Ollama (prompts never leave the machine)
# OLLAMA_HOST=http://127.0.0.1:11434
# FLUX_OLLAMA_MODEL=qwen3:8b
